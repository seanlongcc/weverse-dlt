/* Shared geometry, two palettes resolved by load_app_stylesheet(). */
QWidget {
    font-family: "Segoe UI", "Malgun Gothic", "Noto Sans";
    font-size: 13px;
    color: @text@;
}
QWidget#page, QWidget#workspace { background: @bg@; }
QWidget#header, QWidget#sidebar { background: @panel@; }
QScrollArea { border: none; background: @panel@; }
QSplitter::handle { background: @border@; width: 1px; }
QFrame#divider { background: @border@; border: none; }
QLabel { background: transparent; }
QLabel#brandMark {
    background: @accent@; color: @on_accent@; border-radius: 11px;
    font-size: 30px; font-weight: 800; padding-bottom: 3px;
}
QLabel#brandName { font-size: 20px; font-weight: 700; }
QLabel#eyebrow { font-size: 10px; font-weight: 600; color: @muted@; }
QLabel#pageTitle { font-size: 30px; font-weight: 600; }
QLabel#sectionTitle { font-size: 19px; font-weight: 600; }
QLabel#fieldLabel { font-size: 13px; font-weight: 600; }
QLabel#muted { color: @muted@; }
QLabel#finePrint { color: @muted@; font-size: 11px; }
QLabel[error="true"] { color: @error@; }
QLabel#sessionStatus { color: @muted@; font-size: 12px; padding: 5px 0; }
QLabel#sessionStatus[state="ready"] { color: @accent@; }
QLabel#sessionStatus[state="warning"] { color: @warning@; }
QLabel#runStateChip {
    background: @field@; color: @muted@; border: 1px solid @border@;
    border-radius: 12px; padding: 5px 12px; font-size: 11px; font-weight: 600;
}
QLabel#runStateChip[state="running"], QLabel#runStateChip[state="success"] { color: @accent@; background: @tint@; }
QLabel#runStateChip[state="warning"] { color: @warning@; }
QLabel#runStateChip[state="error"] { color: @error@; }
QLineEdit, QPlainTextEdit, QComboBox {
    background: @field@; border: 1px solid @border@; border-radius: 6px;
    padding: 9px; color: @text@; selection-background-color: @accent@;
    selection-color: @on_accent@;
}
QLineEdit:focus, QPlainTextEdit:focus, QComboBox:focus { border: 1px solid @accent@; }
QLineEdit:disabled, QComboBox:disabled { color: @disabled@; background: @panel@; }
QComboBox { min-height: 18px; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox::down-arrow { image: url("@chevron@"); width: 12px; height: 12px; }
QComboBox QAbstractItemView {
    background: @panel@; color: @text@; border: 1px solid @border@;
    selection-background-color: @tint@; selection-color: @text@; padding: 4px;
}
QPushButton {
    background: @panel@; border: 1px solid @border@; border-radius: 6px;
    color: @text@; font-size: 12px; font-weight: 600; padding: 9px 13px;
}
QPushButton:hover { background: @hover@; }
QPushButton:pressed { background: @tint@; }
QPushButton:focus { border: 1px solid @accent@; }
QPushButton[variant="primary"] { background: @accent@; border-color: @accent@; color: @on_accent@; }
QPushButton[variant="primary"]:hover { background: @accent_hover@; }
QPushButton[variant="primary"]:focus { border: 2px solid @text@; padding: 8px 12px; }
QPushButton[variant="quiet"] { background: transparent; border: 1px solid transparent; color: @muted@; padding: 5px 6px; font-size: 11px; }
QPushButton[variant="quiet"]:hover { background: @hover@; color: @text@; }
QPushButton[variant="quiet"]:focus { border-color: @accent@; }
QPushButton[variant="danger"] { color: @error@; }
QPushButton[variant="theme"] { padding: 8px; color: @muted@; }
QPushButton:disabled, QPushButton[variant="primary"]:disabled, QPushButton[variant="danger"]:disabled,
QPushButton[variant="quiet"]:disabled {
    background: @panel@; color: @disabled@; border-color: @border@;
}
QToolButton { background: transparent; border: 1px solid transparent; color: @muted@; padding: 5px 0; font-size: 11px; }
QToolButton:hover { color: @text@; }
QToolButton:focus { border-color: @accent@; }
QWidget#emptyQueue { background: @panel@; border: 1px solid @border@; border-radius: 6px; }
QTableWidget { background: @panel@; alternate-background-color: @panel@; border: 1px solid @border@; border-radius: 6px; selection-background-color: @tint@; selection-color: @text@; }
QTableWidget::item { border-bottom: 1px solid @border@; padding: 5px; }
QTableWidget::item:selected { background: @tint@; color: @text@; }
QTableWidget::item:focus { border: 1px solid @accent@; }
QHeaderView::section { background: @panel@; color: @muted@; border: none; border-bottom: 1px solid @border@; padding: 10px 5px; font-size: 10px; font-weight: 600; text-align: left; }
QProgressBar { background: @field@; border: none; border-radius: 3px; color: @text@; height: 16px; font-size: 10px; text-align: center; }
QProgressBar::chunk { background: @accent@; border-radius: 3px; }
QLabel#artifactBullet { color: @muted@; font-size: 18px; }
QLabel#artifactBullet[done="true"], QLabel#artifactBullet[active="true"] { color: @accent@; }
QLabel#artifactText { font-size: 12px; }
QPlainTextEdit#activityLog { background: @field@; font-family: "Cascadia Mono", "Consolas", monospace; font-size: 11px; border: 1px solid @border@; }
QToolTip { background: @panel@; color: @text@; border: 1px solid @border@; padding: 6px; }
