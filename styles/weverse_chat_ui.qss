QWidget {
    font-family: "Segoe UI", "Noto Sans";
    font-size: 13px;
    color: #e8eef8;
}

QWidget#page {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #0d1424,
        stop: 1 #121b30
    );
}

QWidget#hero {
    background: #0f1a31;
    border: 1px solid #2a3c66;
    border-radius: 14px;
}

QLabel#heroEyebrow {
    color: #7cb2ff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.8px;
}

QLabel#heroTitle {
    font-size: 22px;
    font-weight: 700;
    color: #f8fbff;
}

QLabel#heroSubtitle {
    color: #99accf;
}

QLabel#runStateChip {
    background: #263554;
    border: 1px solid #3f5687;
    color: #cdd8ec;
    border-radius: 12px;
    padding: 6px 12px;
    font-weight: 600;
}

QLabel#runStateChip[state="idle"] {
    background: #263554;
    border: 1px solid #3f5687;
    color: #cdd8ec;
}

QLabel#runStateChip[state="running"] {
    background: #173d69;
    border: 1px solid #2d73bd;
    color: #cce7ff;
}

QLabel#runStateChip[state="success"] {
    background: #0f4d3d;
    border: 1px solid #1b8f72;
    color: #c3ffe9;
}

QLabel#runStateChip[state="warning"] {
    background: #5a3f14;
    border: 1px solid #ad7f2a;
    color: #ffeac4;
}

QLabel#runStateChip[state="error"] {
    background: #581f2e;
    border: 1px solid #b44a63;
    color: #ffd7e1;
}

QWidget#card {
    background: #18233d;
    border: 1px solid #2b3f69;
    border-radius: 14px;
}

QLabel#cardTitle {
    color: #f5f9ff;
    font-size: 18px;
    font-weight: 700;
}

QLabel#cardTitle[hasSubtitle="false"] {
    padding-bottom: 14px;
}

QLabel#cardSubtitle {
    color: #9cafcf;
    font-size: 12px;
    padding-bottom: 2px;
}

QLabel#fieldLabel {
    color: #cfdbf3;
    font-weight: 600;
    background: #18233d;
    padding-left: 2px;
}

QLineEdit {
    background: #101a31;
    border: 1px solid #324a79;
    border-radius: 8px;
    padding: 9px;
    color: #ebf2ff;
    selection-background-color: #2c7be5;
}

QTextEdit, QPlainTextEdit {
    background: #101a31;
    border: 1px solid #324a79;
    border-radius: 4px;
    color: #ebf2ff;
    selection-background-color: #2c7be5;
}

QTextEdit QWidget, QPlainTextEdit QWidget {
    background: #101a31;
    border-radius: 3px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #4a95ff;
}

QPushButton {
    background: #2c7be5;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 10px 16px;
    font-weight: 700;
}

QPushButton:hover {
    background: #2267c3;
}

QPushButton:disabled {
    background: #365181;
    color: #9fb4d8;
}

QPushButton#stopButton {
    background: #9b2f4d;
}

QPushButton#stopButton:hover {
    background: #7e2640;
}

QPushButton#stopButton:disabled {
    background: #5a3341;
    color: #c5a5b0;
}

QWidget#artifactRow {
    background: transparent;
}

QLabel#artifactText {
    color: #d8e4fb;
}

QLabel#artifactSpinner {
    color: #4b5f86;
    font-family: "Consolas", "Courier New", monospace;
    font-weight: 700;
}

QLabel#artifactSpinner[active="true"] {
    color: #7cb2ff;
}

QLabel#artifactBullet {
    color: #4b5f86;
    font-size: 16px;
    font-weight: 700;
}

QLabel#artifactBullet[done="true"] {
    color: #2dd4bf;
}
